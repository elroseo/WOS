filters:
  or:
    - file.inFolder("00 Inbox")
    - file.inFolder("10 Projects")
    - file.inFolder("20 Areas")
    - file.inFolder("30 Resources")
    - file.inFolder("40 Archives")
properties:
  file.name:
    displayName: Note
  file.folder:
    displayName: PARA location
  file.mtime:
    displayName: Updated
views:
  - type: table
    name: Projects
    filters: file.inFolder("10 Projects")
    order:
      - file.name
      - file.folder
      - file.mtime
  - type: table
    name: Areas
    filters: file.inFolder("20 Areas")
    order:
      - file.name
      - file.folder
      - file.mtime
  - type: table
    name: Resources
    filters: file.inFolder("30 Resources")
    order:
      - file.name
      - file.folder
      - file.mtime
  - type: table
    name: Inbox
    filters: file.inFolder("00 Inbox")
    order:
      - file.name
      - file.mtime
